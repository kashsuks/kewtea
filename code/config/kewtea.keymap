/*
 * kewtea.keymap
 *
 * Single-layer QWERTY keymap for the kewtea 30% ortholinear keyboard.
 * Layout (3 rows × 10 columns, 30 keys total):
 *
 *   Q  W  E  R  T  Y  U  I  O  P
 *   A  S  D  F  G  H  J  K  L  ;
 *   Z  X  C  V  __ B  N  M  ,  .
 *
 * The bottom-row centre key (ROW2/COL4) is Space.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /**
         * @brief Default layer — unshifted QWERTY with space in the centre.
         *
         * Bindings are listed left-to-right, top-to-bottom, matching the
         * physical key order reported by the kscan matrix in kewtea.overlay.
         */
        default_layer {
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp Y    &kp U    &kp I    &kp O    &kp P

                &kp A    &kp S    &kp D    &kp F    &kp G
                &kp H    &kp J    &kp K    &kp L    &kp SEMI

                &kp Z    &kp X    &kp C    &kp V    &kp SPACE
                &kp B    &kp N    &kp M    &kp COMMA &kp DOT
            >;
        };
    };
};
